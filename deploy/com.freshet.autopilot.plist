<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.freshet.autopilot</string>

  <!-- Supervises the WHOLE pipeline (poller + embedder + autopilot), not the
       autopilot alone: freshness measures the poller and the embedder, and an
       unsupervised crash in either ends the continuous run being measured.

       KNOWN LIMITATION: a launchd agent does not inherit the Terminal's
       permission to read ~/Documents, so with the repo there this agent fails
       with "Operation not permitted" before it can exec anything. To run
       unattended from a cold boot, either grant Full Disk Access to /bin/sh in
       System Settings > Privacy & Security, or move the repo outside
       ~/Documents. Measurement runs to date were launched from an already
       permitted session instead. -->
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/deploy/run-live.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <!-- Restart on crash, but NOT on a clean exit: a deliberate stop stays
         stopped, and a config error that exits 0 must not spin. -->
    <key>SuccessfulExit</key><false/>
  </dict>
  <!-- A crash-loop must not become a spend-loop. The LLM budget in Postgres is
       the real guard; this is the second. -->
  <key>ThrottleInterval</key><integer>60</integer>

  <!-- Background priority: this shares the laptop with actual work. -->
  <key>Nice</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>

  <key>StandardOutPath</key><string>__REPO__/logs/autopilot.log</string>
  <key>StandardErrorPath</key><string>__REPO__/logs/autopilot.err</string>
</dict>
</plist>
