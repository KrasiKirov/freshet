<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.freshet.autopilot</string>

  <!-- `make run-forever` sources .env.local, so secrets stay out of this file
       and out of git. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd __REPO__ &amp;&amp; exec make run-forever</string>
  </array>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <!-- Restart on crash, but NOT on a clean exit: a deliberate stop should stay
         stopped, and a config error that exits 0 should not spin. -->
    <key>SuccessfulExit</key><false/>
  </dict>
  <!-- A crash-loop must not become a spend-loop. The LLM budget is the real
       guard (it lives in Postgres and survives restarts); this is the second. -->
  <key>ThrottleInterval</key><integer>60</integer>

  <!-- Background priority: this shares the laptop with actual work. -->
  <key>Nice</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>

  <key>StandardOutPath</key><string>__REPO__/logs/autopilot.log</string>
  <key>StandardErrorPath</key><string>__REPO__/logs/autopilot.err</string>
</dict>
</plist>
