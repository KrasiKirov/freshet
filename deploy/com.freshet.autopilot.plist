<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.freshet.autopilot</string>

  <!-- Runs the venv python DIRECTLY, not `cd … && make`.
       A launchd agent does not inherit the Terminal's permission to read
       ~/Documents, so `make` failed with "getcwd: Operation not permitted"
       before it could find a target. Absolute paths and an explicit
       WorkingDirectory avoid needing getcwd at all.
       If the agent still cannot read the repo, grant Full Disk Access to
       /bin/sh in System Settings > Privacy & Security, or move the repo
       outside ~/Documents. -->
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/deploy/run-autopilot.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <!-- Restart on crash, but NOT on a clean exit: a deliberate stop stays
         stopped, and a config error that exits 0 must not spin. -->
    <key>SuccessfulExit</key><false/>
  </dict>
  <!-- A crash-loop must not become a spend-loop. The LLM budget in Postgres is
       the real guard; this is the second. -->
  <key>ThrottleInterval</key><integer>60</integer>

  <!-- Background priority: this shares the laptop with actual work. -->
  <key>Nice</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>

  <key>StandardOutPath</key><string>__REPO__/logs/autopilot.log</string>
  <key>StandardErrorPath</key><string>__REPO__/logs/autopilot.err</string>
</dict>
</plist>
